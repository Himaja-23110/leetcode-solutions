class Solution {
    public void moveZeroes(int[] nums) {
        int X = 0;

        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != 0) {
                int temp = nums[X];
                nums[X] = nums[i];
                nums[i] = temp;
                X++;
            }
        }
    }
}
